<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'System' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar') %>
  <main class="main">
    <div class="container container--narrow">
      <%- include('partials/settings-tabs') %>

      <% if (updateInfo.updateAvailable) { %>
      <section class="update-banner" aria-label="Update available">
        <div class="update-banner-left">
          <%- include('partials/icon', { name: 'upload', size: 22 }) %>
          <div>
            <div class="update-banner-title">Rowan Hub v<%= updateInfo.latestVersion %> is available</div>
            <div class="update-banner-sub">You're on v<%= updateInfo.currentVersion %>.<% if (updateInfo.publishedAt) { %> Released <%= new Date(updateInfo.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>.<% } %></div>
          </div>
        </div>
        <div class="page-actions">
          <a href="<%= updateInfo.releaseUrl %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">What's new</a>
          <button class="btn btn-primary btn-sm" id="btn-update-now">Update now</button>
        </div>
      </section>
      <% } %>

      <div class="grid-2">
        <section class="card" aria-labelledby="hub-title">
          <h2 id="hub-title">This hub</h2>
          <p class="card-sub">Rowan Hub v<%= updateInfo.currentVersion %><%= updateInfo.updateAvailable ? '' : ' · up to date' %></p>
          <div style="margin-top:12px">
            <div class="stat-item"><span class="stat-label">Running for</span><span class="stat-value" id="stat-uptime">–</span></div>
            <div class="stat-item"><span class="stat-label">Devices</span><span class="stat-value" id="stat-devices">–</span></div>
            <div class="stat-item"><span class="stat-label">Memory</span><span class="stat-value" id="stat-mem">–</span></div>
            <div class="progress-bar"><div class="progress-fill" id="stat-mem-bar" style="width:0%"></div></div>
            <div class="stat-item"><span class="stat-label">CPU load (1 min)</span><span class="stat-value" id="stat-cpu">–</span></div>
          </div>
        </section>

        <section class="card" aria-labelledby="tech-title">
          <h2 id="tech-title">Technical details</h2>
          <p class="card-sub">Useful when asking for help.</p>
          <div style="margin-top:12px">
            <div class="stat-item"><span class="stat-label">Hostname</span><span class="stat-value mono" id="stat-host">–</span></div>
            <div class="stat-item"><span class="stat-label">Node.js</span><span class="stat-value mono" id="stat-node">–</span></div>
            <div class="stat-item"><span class="stat-label">Matter port</span><span class="stat-value mono"><%= bridge.port || 5540 %></span></div>
            <div class="stat-item"><span class="stat-label">Discriminator</span><span class="stat-value mono"><%= bridge.discriminator ?? 3840 %></span></div>
          </div>
        </section>
      </div>

      <section class="card" aria-labelledby="push-title" style="display:flex;flex-wrap:wrap;align-items:center;gap:16px 24px">
        <span class="row-icon"><%- include('partials/icon', { name: 'bell' }) %></span>
        <div style="flex:1 1 280px">
          <h2 id="push-title">Notifications on this device</h2>
          <p class="card-sub">Get an alert when a device stops responding, an automation runs, or an update is ready. Needs a trusted HTTPS address on phones.</p>
          <p id="push-status-text" class="form-hint"></p>
        </div>
        <button class="btn btn-primary" id="btn-push-toggle">Turn on notifications</button>
      </section>

      <section class="danger-zone" aria-labelledby="restart-title">
        <div>
          <h2 id="restart-title">Restart Rowan Hub</h2>
          <p class="card-sub">Your devices are unavailable in your home apps for a few seconds.</p>
        </div>
        <button class="btn btn-danger" id="btn-restart"><%- include('partials/icon', { name: 'restart', size: 18 }) %>Restart</button>
      </section>

    </div>
  </main>
</div>
<script src="/js/main.js"></script>
<script src="/js/system.js"></script>
</body>
</html>
