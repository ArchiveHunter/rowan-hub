<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Scenes' }) %>
</head>
<body>
<%
  function nameOf(id) { return deviceNames[id] || id; }
  function cap(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }
%>
<div class="app">
  <%- include('partials/sidebar') %>
  <main class="main">
    <div class="container container--narrow">

      <header class="page-head">
        <div>
          <h1>Scenes</h1>
          <p class="page-sub">Set several devices at once. Each scene also appears as a switch in your home apps.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-primary" id="btn-add-scene"><%- include('partials/icon', { name: 'plus', size: 16, stroke: 2.2 }) %>New scene</button>
        </div>
      </header>

      <% if (scenes.length === 0) { %>
      <div class="empty-state">
        <span class="empty-icon"><%- include('partials/icon', { name: 'scenes', size: 26 }) %></span>
        <h2>No scenes yet</h2>
        <p>A scene sets several devices in one go — for example “Movie Time” dims the living room and turns off the downlights.</p>
        <button class="btn btn-primary" id="btn-add-scene-empty">Create a scene</button>
      </div>
      <% } else { %>
      <div class="scene-grid">
        <% scenes.forEach(function (scene) {
             var skipped = scene.actions.filter(function (a) { return disabledIds.indexOf(a.device) !== -1; })
                                        .map(function (a) { return nameOf(a.device); }); %>
        <article class="card scene-card" data-scene-id="<%= scene.id %>">
          <h3><%= scene.name %></h3>
          <p class="sentence"><%= cap(describe.actionsText(scene.actions, nameOf)) %>.</p>
          <% if (skipped.length) { %>
          <p class="warn-text" style="margin-top:-6px"><%- include('partials/icon', { name: 'warn', size: 15, stroke: 2 }) %><%= describe.joinNames(skipped) %> <%= skipped.length === 1 ? 'is' : 'are' %> disabled and will be skipped</p>
          <% } %>
          <div class="row-actions">
            <button class="btn btn-primary btn-sm btn-trigger-scene" data-id="<%= scene.id %>"><%- include('partials/icon', { name: 'play', size: 14 }) %>Run</button>
            <button class="btn btn-secondary btn-sm btn-edit-scene" data-id="<%= scene.id %>"><%- include('partials/icon', { name: 'edit', size: 16 }) %>Edit</button>
            <button class="btn-icon btn-delete-scene" data-id="<%= scene.id %>" aria-label="Delete <%= scene.name %>" title="Delete"><%- include('partials/icon', { name: 'trash', size: 18 }) %></button>
          </div>
        </article>
        <% }); %>
      </div>
      <% } %>

    </div>
  </main>
</div>

<div class="modal-overlay" id="scene-modal" role="dialog" aria-modal="true" aria-labelledby="scene-modal-title">
  <div class="modal">
    <div class="modal-header">
      <h2 class="modal-title" id="scene-modal-title">New scene</h2>
      <button class="modal-close" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="scene-id">
      <div class="form-group">
        <label class="form-label" for="scene-name">Name</label>
        <input type="text" class="form-input" id="scene-name" placeholder="e.g. Movie Time, Goodnight">
      </div>
      <div class="form-group">
        <label class="form-label">What should it do?</label>
        <div id="scene-actions-list"></div>
        <button class="btn btn-dashed btn-sm" id="btn-add-scene-action" type="button">+ Add a device</button>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary modal-close">Cancel</button>
      <button class="btn btn-primary" id="btn-save-scene">Save scene</button>
    </div>
  </div>
</div>

<script>
  window.DEVICES = <%- JSON.stringify(devices).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/main.js"></script>
<script src="/js/scenes.js"></script>
</body>
</html>
