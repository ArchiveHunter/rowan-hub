<%
  var current = locals.page || '';
  var items = [
    { id: 'home', href: '/dashboard', label: 'Home', icon: 'home' },
    { id: 'devices', href: '/devices', label: 'Devices', icon: 'light' },
    { id: 'scenes', href: '/scenes', label: 'Scenes', icon: 'scenes' },
    { id: 'automations', href: '/automations', label: 'Automations', icon: 'automations' },
  ];
  var who = locals.user || '';
%>
<nav class="sidebar" aria-label="Main">
  <a class="brand" href="/dashboard">
    <img src="/icon-192.png" alt="">
    <span>Rowan Hub</span>
  </a>
  <% items.forEach(function (it) { %>
  <a class="nav-link" href="<%= it.href %>"<%- current === it.id ? ' aria-current="page"' : '' %>>
    <%- include('icon', { name: it.icon }) %>
    <%= it.label %>
  </a>
  <% }); %>
  <div class="nav-spacer"></div>
  <a class="nav-link" href="/settings"<%- current === 'settings' ? ' aria-current="page"' : '' %>>
    <%- include('icon', { name: 'settings' }) %>
    Settings
  </a>
  <div class="sidebar-user">
    <span class="avatar" aria-hidden="true"><%= who.charAt(0) || '?' %></span>
    <span class="who"><strong><%= who %></strong><span>v<%= locals.version %></span></span>
    <button class="btn-icon" onclick="signOut()" aria-label="Sign out" title="Sign out">
      <%- include('icon', { name: 'signout', size: 18 }) %>
    </button>
  </div>
</nav>

<nav class="tabbar" aria-label="Main">
  <% items.forEach(function (it) { %>
  <a href="<%= it.href %>"<%- current === it.id ? ' aria-current="page"' : '' %>>
    <%- include('icon', { name: it.icon, size: 24 }) %>
    <%= it.label %>
  </a>
  <% }); %>
  <a href="/settings"<%- current === 'settings' ? ' aria-current="page"' : '' %>>
    <%- include('icon', { name: 'more', size: 24 }) %>
    More
  </a>
</nav>
