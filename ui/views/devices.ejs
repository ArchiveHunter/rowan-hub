<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Devices' }) %>
</head>
<body>
<%
  var LABELS = {};
  Object.keys(schemas).forEach(function (k) { LABELS[k] = schemas[k].label || k; });
  function details(d) {
    var bits = [];
    if (d.room) bits.push(d.room);
    bits.push(LABELS[d.plugin] || d.plugin);
    if (d.host) bits.push(d.host);
    if (d.device_id) bits.push('ID ' + d.device_id);
    if (d.channel !== undefined && d.channel !== null && d.channel !== '') bits.push('channel ' + d.channel);
    return bits.join(' · ');
  }
%>
<div class="app">
  <%- include('partials/sidebar') %>
  <main class="main">
    <div class="container container--narrow">

      <header class="page-head">
        <div>
          <h1>Devices</h1>
          <p class="page-sub"><%= devices.length %> device<%= devices.length === 1 ? '' : 's' %> · changes apply after a restart unless noted</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-primary" id="btn-add-device"><%- include('partials/icon', { name: 'plus', size: 16, stroke: 2.2 }) %>Add device</button>
        </div>
      </header>

      <% if (devices.length === 0) { %>
      <div class="empty-state">
        <span class="empty-icon"><%- include('partials/icon', { name: 'light', size: 26 }) %></span>
        <h2>No devices yet</h2>
        <p>Pick the kind of device (WLED, Tasmota, Shelly…) and enter its address. It will appear on the Home screen and in your home apps.</p>
        <button class="btn btn-primary" id="btn-add-device-empty">Add your first device</button>
      </div>
      <% } else { %>
      <div class="list">
        <% devices.forEach(function (device) {
             var disabled = device.enabled === false;
             var live = liveIds.indexOf(device.id) !== -1; %>
        <div class="row<%= disabled ? ' is-muted' : '' %>" data-device-id="<%= device.id %>">
          <span class="row-icon"><%- include('partials/icon', { name: describe.deviceKind(device) }) %></span>
          <div class="row-main">
            <div class="row-title">
              <%= device.name %>
              <% if (disabled) { %><span class="pill">Disabled</span>
              <% } else if (!live) { %><span class="pill pill--warn">Restart to activate</span><% } %>
            </div>
            <div class="row-sub"><%= details(device) %></div>
          </div>
          <div class="row-actions">
            <button class="btn btn-secondary btn-sm btn-edit" data-device-id="<%= device.id %>">
              <%- include('partials/icon', { name: 'edit', size: 16 }) %>Edit
            </button>
            <button class="btn btn-secondary btn-sm btn-toggle" data-device-id="<%= device.id %>" data-enabled="<%= !disabled %>">
              <%= disabled ? 'Enable' : 'Disable' %>
            </button>
            <button class="btn-icon btn-delete" data-device-id="<%= device.id %>" data-device-name="<%= device.name %>" aria-label="Remove <%= device.name %>" title="Remove">
              <%- include('partials/icon', { name: 'trash', size: 18 }) %>
            </button>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>

    </div>
  </main>
</div>

<!-- Add -->
<div class="modal-overlay" id="add-modal" role="dialog" aria-modal="true" aria-labelledby="add-modal-title">
  <div class="modal">
    <div class="modal-header">
      <h2 class="modal-title" id="add-modal-title">Add device</h2>
      <button class="modal-close" data-modal="add-modal" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label>What kind of device is it?</label>
        <div class="plugin-selector" id="plugin-selector">
          <% enabledPlugins.forEach(function (pluginName) { var schema = schemas[pluginName] || {}; %>
          <button class="plugin-choice" data-plugin="<%= pluginName %>" type="button"><%= schema.label || pluginName %></button>
          <% }); %>
        </div>
        <span class="form-hint">Don't see yours? Turn it on under <a href="/plugins">Settings → Integrations</a>.</span>
      </div>
      <div id="add-dynamic-fields"></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" data-modal="add-modal">Cancel</button>
      <button class="btn btn-primary" id="btn-save-add">Add device</button>
    </div>
  </div>
</div>

<!-- Edit -->
<div class="modal-overlay" id="edit-modal" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">
  <div class="modal">
    <div class="modal-header">
      <h2 class="modal-title" id="edit-modal-title">Edit device</h2>
      <button class="modal-close" data-modal="edit-modal" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <div id="edit-dynamic-fields"></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" data-modal="edit-modal">Cancel</button>
      <button class="btn btn-primary" id="btn-save-edit">Save changes</button>
    </div>
  </div>
</div>

<!-- Remove -->
<div class="modal-overlay" id="delete-modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
  <div class="modal modal--sm">
    <div class="modal-header">
      <h2 class="modal-title" id="delete-modal-title">Remove device?</h2>
      <button class="modal-close" data-modal="delete-modal" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <p><strong id="delete-device-name"></strong> will disappear from Rowan Hub and your home apps. Scenes and automations that use it will skip it.</p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" data-modal="delete-modal">Cancel</button>
      <button class="btn btn-danger" id="btn-confirm-delete">Remove</button>
    </div>
  </div>
</div>

<script>
  window.DEVICES_DATA = <%- JSON.stringify(devices).replace(/</g, '\\u003c') %>;
  window.PLUGIN_SCHEMAS = <%- JSON.stringify(schemas).replace(/</g, '\\u003c') %>;
  window.ENABLED_PLUGINS = <%- JSON.stringify(enabledPlugins).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/main.js"></script>
<script src="/js/config.js"></script>
</body>
</html>
