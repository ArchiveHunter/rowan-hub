<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%- include('partials/head') %>
</head>
<body>
<div class="app-layout">
  <%- include('partials/sidebar', { page: 'devices' }) %>
  <main class="main-content">
    <div class="page-container">

      <div class="page-header">
        <h1>Devices</h1>
        <div class="header-actions">
          <button class="btn btn-primary" id="btn-add-device">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="8" y1="2" x2="8" y2="14"/><line x1="2" y1="8" x2="14" y2="8"/></svg>
            Add Device
          </button>
        </div>
      </div>

      <% if (devices.length === 0) { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.3">
            <rect x="1" y="3" width="14" height="10" rx="1.5"/>
          </svg>
          <p>No devices configured yet.</p>
          <button class="btn btn-primary" id="btn-add-device-empty">Add your first device</button>
        </div>
      <% } else { %>
      <div class="card">
        <table class="device-table">
          <thead>
            <tr>
              <th>Plugin</th>
              <th>Name</th>
              <th>Details</th>
              <th>Status</th>
              <th style="text-align:right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% devices.forEach(function(device) { %>
            <tr data-device-id="<%= device.id %>">
              <td><span class="plugin-badge plugin-badge--<%= device.plugin %>"><%= device.plugin %></span></td>
              <td class="device-name-cell"><strong><%= device.name %></strong><br><span class="text-muted" style="font-size:11px"><%= device.id %></span></td>
              <td class="text-muted" style="font-size:12px">
                <% if (device.host) { %><span>IP: <%= device.host %></span><% } %>
                <% if (device.device_id) { %><span><%= device.host ? ' · ' : '' %>ID: <%= device.device_id %></span><% } %>
                <% if (device.channel !== undefined && device.channel !== null) { %><span> · ch<%= device.channel %></span><% } %>
              </td>
              <td>
                <% var isLive = liveIds.indexOf(device.id) !== -1; %>
                <% var isDisabled = device.enabled === false; %>
                <% if (isDisabled) { %>
                  <span class="status-pill status-pill--disabled">Disabled</span>
                <% } else { %>
                  <span class="status-pill <%= isLive ? 'status-pill--live' : 'status-pill--pending' %>"><%= isLive ? 'Live' : 'Pending restart' %></span>
                <% } %>
              </td>
              <td style="text-align:right">
                <button class="btn-icon btn-toggle" data-device-id="<%= device.id %>" data-enabled="<%= device.enabled !== false %>" title="<%= device.enabled !== false ? 'Disable device' : 'Enable device' %>">
                  <% if (device.enabled !== false) { %>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="2" width="2" height="12" rx="1"/><rect x="9" y="2" width="2" height="12" rx="1"/>
                  </svg>
                  <% } else { %>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="3,2 13,8 3,14"/>
                  </svg>
                  <% } %>
                </button>
                <button class="btn-icon btn-edit" data-device-id="<%= device.id %>" title="Edit device">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11.5 2.5a1.414 1.414 0 0 1 2 2L5 13l-3 1 1-3 8.5-8.5z"/>
                  </svg>
                </button>
                <button class="btn-icon btn-delete" data-device-id="<%= device.id %>" data-device-name="<%= device.name %>" title="Remove device">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="2 4 14 4"/><path d="M5 4V2h6v2"/><path d="M6 7v5M10 7v5"/><path d="M3 4l1 9a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1l1-9"/>
                  </svg>
                </button>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>

    </div>
  </main>
</div>

<!-- Add Modal -->
<div class="modal-overlay" id="add-modal" role="dialog" aria-modal="true" aria-labelledby="add-modal-title">
  <div class="modal">
    <div class="modal-header">
      <h2 class="modal-title" id="add-modal-title">Add Device</h2>
      <button class="modal-close" data-modal="add-modal" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label>Plugin</label>
        <div class="plugin-selector" id="plugin-selector">
          <% enabledPlugins.forEach(function(pluginName) {
            var schema = schemas[pluginName] || {};
          %>
          <button class="plugin-choice" data-plugin="<%= pluginName %>" type="button">
            <span class="plugin-choice-dot" style="background:<%= schema.color || '#888' %>"></span>
            <%= schema.label || pluginName %>
          </button>
          <% }); %>
        </div>
      </div>
      <div id="add-dynamic-fields"></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" data-modal="add-modal">Cancel</button>
      <button class="btn btn-primary" id="btn-save-add">Save Device</button>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal-overlay" id="edit-modal" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">
  <div class="modal">
    <div class="modal-header">
      <h2 class="modal-title" id="edit-modal-title">Edit Device</h2>
      <button class="modal-close" data-modal="edit-modal" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <div id="edit-dynamic-fields"></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" data-modal="edit-modal">Cancel</button>
      <button class="btn btn-primary" id="btn-save-edit">Save Changes</button>
    </div>
  </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal-overlay" id="delete-modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
  <div class="modal modal--sm">
    <div class="modal-header">
      <h2 class="modal-title" id="delete-modal-title">Remove Device</h2>
      <button class="modal-close" data-modal="delete-modal" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <p>Are you sure you want to remove <strong id="delete-device-name"></strong>? This cannot be undone.</p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" data-modal="delete-modal">Cancel</button>
      <button class="btn btn-danger" id="btn-confirm-delete">Remove</button>
    </div>
  </div>
</div>

<script>
  window.DEVICES_DATA = <%- JSON.stringify(devices).replace(/</g, '\\u003c') %>;
  window.PLUGIN_SCHEMAS = <%- JSON.stringify(schemas).replace(/</g, '\\u003c') %>;
  window.ENABLED_PLUGINS = <%- JSON.stringify(enabledPlugins).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/main.js"></script>
<script src="/js/config.js"></script>
</body>
</html>
