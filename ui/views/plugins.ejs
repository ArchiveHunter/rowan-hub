<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Integrations' }) %>
</head>
<body>
<%
  var ICONS = { wled: 'strip', tasmota: 'plug', ewelink: 'cloud', shelly: 'switch', mqtt: 'broadcast', zigbee2mqtt: 'mesh', daikin: 'climate' };
  var BLURB = {
    wled: 'LED strips running WLED, on your network',
    tasmota: 'Plugs and switches running Tasmota firmware',
    ewelink: 'Sonoff devices via your eWeLink account, with local control',
    shelly: 'Shelly relays, dimmers and rollers',
    mqtt: 'Any device that talks MQTT',
    zigbee2mqtt: 'Zigbee devices through a Zigbee2MQTT bridge',
    daikin: 'Daikin air conditioners on your network',
  };
%>
<style>
  .plugin-card details { flex-basis: 100%; margin: 0 0 4px 54px; }
  .plugin-card summary { cursor: pointer; font-size: 14px; font-weight: 600; color: var(--accent-text); min-height: 32px; display: inline-flex; align-items: center; }
  .plugin-settings { margin-top: 12px; max-width: 520px; }
  .plugin-settings--disabled { opacity: .55; }
  .plugin-settings-footer { display: flex; align-items: center; gap: 12px; }
  .save-status { font-size: 13px; }
  @media (max-width: 760px) { .plugin-card details { margin-left: 0; } }
</style>
<div class="app">
  <%- include('partials/sidebar') %>
  <main class="main">
    <div class="container container--narrow">
      <%- include('partials/settings-tabs') %>

      <div class="list">
        <div class="card-head">
          <div>
            <h2>Integrations</h2>
            <p class="card-sub">How Rowan Hub talks to your devices. Turn on the ones you use — changes apply after a restart.</p>
          </div>
        </div>
        <% plugins.forEach(function (plugin) { %>
        <div class="row plugin-card<%= plugin.enabled ? '' : ' is-muted' %>" data-plugin="<%= plugin.name %>">
          <span class="row-icon"><%- include('partials/icon', { name: ICONS[plugin.name] || 'light' }) %></span>
          <div class="row-main">
            <div class="row-title"><%= plugin.label %></div>
            <div class="row-sub"><%= plugin.deviceCount ? plugin.deviceCount + ' device' + (plugin.deviceCount === 1 ? '' : 's') : 'No devices yet' %> · <%= BLURB[plugin.name] || '' %></div>
          </div>
          <label class="toggle-switch" title="<%= plugin.enabled ? 'Turn off' : 'Turn on' %> <%= plugin.label %>">
            <input type="checkbox" class="plugin-toggle" data-plugin="<%= plugin.name %>" aria-label="<%= plugin.label %>" <%= plugin.enabled ? 'checked' : '' %>>
            <span class="toggle-slider"></span>
          </label>
          <% if (plugin.globalFields && plugin.globalFields.length > 0) { %>
          <details<%= plugin.enabled && !plugin.globalConfig ? ' open' : '' %>>
            <summary>Account &amp; connection settings</summary>
            <div class="plugin-settings<%= plugin.enabled ? '' : ' plugin-settings--disabled' %>">
              <form class="plugin-settings-form" data-plugin="<%= plugin.name %>">
                <% plugin.globalFields.forEach(function (field) { %>
                <div class="form-group">
                  <label for="<%= plugin.name %>-<%= field.name %>"><%= field.label %><% if (field.required) { %> <span class="required">*</span><% } %></label>
                  <% if (field.type === 'select') { %>
                  <select id="<%= plugin.name %>-<%= field.name %>" name="<%= field.name %>">
                    <% (field.options || []).forEach(function (opt) { %>
                    <option value="<%= opt %>" <%= plugin.globalConfig && plugin.globalConfig[field.name] === opt ? 'selected' : '' %>><%= opt.toUpperCase() %></option>
                    <% }); %>
                  </select>
                  <% } else { %>
                  <input type="<%= field.type === 'password' ? 'password' : 'text' %>" id="<%= plugin.name %>-<%= field.name %>" name="<%= field.name %>"
                    value="<%= plugin.globalConfig && plugin.globalConfig[field.name] ? plugin.globalConfig[field.name] : '' %>"
                    <% if (field.placeholder) { %>placeholder="<%= field.placeholder %>"<% } %> <% if (field.required) { %>required<% } %>
                    <% if (field.type === 'password') { %>autocomplete="new-password"<% } %>>
                  <% } %>
                </div>
                <% }); %>
                <div class="plugin-settings-footer">
                  <button type="submit" class="btn btn-primary btn-sm">Save settings</button>
                  <span class="save-status" aria-live="polite"></span>
                </div>
              </form>
            </div>
          </details>
          <% } %>
        </div>
        <% }); %>
        <div class="row">
          <span class="row-icon"><%- include('partials/icon', { name: 'server' }) %></span>
          <div class="row-main">
            <div class="row-title">Internal MQTT broker <span class="pill<%= brokerRunning ? ' pill--success' : '' %>"><%= brokerRunning ? 'Running' : 'Stopped' %></span></div>
            <div class="row-sub">Lets Tasmota and Shelly devices report changes instantly instead of being polled</div>
          </div>
          <a class="btn btn-secondary btn-sm" href="/mqtt"><%= brokerRunning ? 'Manage' : 'Set up' %></a>
        </div>
      </div>

    </div>
  </main>
</div>
<script src="/js/main.js"></script>
<script>
(function () {
  document.querySelectorAll('.plugin-toggle').forEach(function (toggle) {
    toggle.addEventListener('change', async function () {
      var pluginName = toggle.dataset.plugin;
      var enabled = toggle.checked;
      var card = toggle.closest('.plugin-card');
      var settingsEl = card.querySelector('.plugin-settings');
      try {
        await api('PUT', '/api/plugins/' + pluginName + '/toggle', { enabled: enabled });
        card.classList.toggle('is-muted', !enabled);
        if (settingsEl) settingsEl.classList.toggle('plugin-settings--disabled', !enabled);
        showToast((enabled ? 'Turned on ' : 'Turned off ') + pluginName + ' — restart Rowan Hub to apply');
      } catch (err) {
        toggle.checked = !enabled;
        showToast(err.message, 'error');
      }
    });
  });

  document.querySelectorAll('.plugin-settings-form').forEach(function (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var statusEl = form.querySelector('.save-status');
      var btn = form.querySelector('button[type="submit"]');
      var data = {};
      new FormData(form).forEach(function (v, k) { data[k] = v; });
      btn.disabled = true;
      statusEl.textContent = 'Saving…';
      statusEl.style.color = 'var(--text-muted)';
      try {
        await api('PUT', '/api/plugins/' + form.dataset.plugin, data);
        statusEl.textContent = 'Saved — restart to apply';
        statusEl.style.color = 'var(--success-text)';
      } catch (err) {
        statusEl.textContent = err.message;
        statusEl.style.color = 'var(--danger)';
      } finally {
        btn.disabled = false;
      }
    });
  });
})();
</script>
</body>
</html>
