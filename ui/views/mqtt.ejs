<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'MQTT broker' }) %></head>
<body>
<div class="app">
  <%- include('partials/sidebar') %>
  <main class="main">
    <div class="container container--narrow mqtt-page">
      <%- include('partials/settings-tabs') %>

      <div>
        <a href="/plugins" style="font-size:14px;font-weight:600">← Integrations</a>
        <h2 class="section-title" style="margin-top:10px">Internal MQTT broker</h2>
        <p class="page-sub">Lets Tasmota and Shelly devices report changes instantly instead of being polled. Set it up once per device.</p>
      </div>

      <% if (!brokerAvailable) { %>
      <div class="alert alert-warn">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M8 1L15 14H1L8 1z"/><path d="M8 6v4M8 11.5v.5"/></svg>
        Mosquitto is not installed. Run <code>apt install mosquitto</code> on this machine, then reload this page.
      </div>
      <% } else { %>

      <!-- Broker status card -->
      <div class="card" style="margin-bottom:24px;">
        <div class="card-body" style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
          <div style="flex:1; min-width:200px;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
              <span class="status-dot <%= brokerRunning ? 'online' : 'offline' %>" id="broker-dot"></span>
              <span style="font-weight:700; font-size:16px;" id="broker-status-text"><%= brokerRunning ? 'Running' : 'Stopped' %></span>
            </div>
            <% if (brokerRunning) { %>
            <div style="display:flex; align-items:center; gap:8px;">
              <code class="inline-code" id="broker-addr"><%= localIp %>:1883</code>
              <button class="btn-icon" onclick="copyAddr()" title="Copy address">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M3 11H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1"/></svg>
              </button>
            </div>
            <div style="display:flex; align-items:center; gap:8px; margin-top:6px; font-size:13px; color:var(--text-muted);">
              User <code class="inline-code"><%= mqttUser %></code>
              Password <code class="inline-code"><%= mqttPass %></code>
              <button class="btn-icon" onclick="copy(<%= JSON.stringify(mqttPass) %>)" title="Copy password">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M3 11H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1"/></svg>
              </button>
            </div>
            <% } else { %>
            <div style="color:var(--text-muted); font-size:13px;">Start the broker to see the connection address.</div>
            <% } %>
          </div>
          <div style="display:flex; gap:10px; align-items:center;">
            <% if (brokerRunning) { %>
            <button class="btn btn-sm btn-danger" id="broker-toggle-btn" onclick="toggleBroker(false)">Stop broker</button>
            <% } else { %>
            <button class="btn btn-sm btn-primary" id="broker-toggle-btn" onclick="toggleBroker(true)">Start broker</button>
            <% } %>
          </div>
        </div>
        <div class="alert alert-info restart-notice" id="restart-notice" style="margin:0 16px 16px; display:none;">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 1"/></svg>
          Restart Rowan Hub to activate MQTT mode in plugins.
          <button class="btn btn-xs btn-primary" style="margin-left:10px;" onclick="restart()">Restart now</button>
        </div>
        <% if (brokerEnabled) { %>
        <div class="alert alert-info" style="margin:0 16px 16px;">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 1"/></svg>
          MQTT mode is active — Tasmota and Shelly devices with topics configured are using push instead of polling.
        </div>
        <% } %>
      </div>

      <% if (brokerEnabled && brokerRunning && (tasmotaDevices.length || shellyDevices.length)) { %>
      <!-- Which devices actually reach the broker (helps after the v1.2.0 password change) -->
      <div class="card" id="mqtt-conn">
        <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
          <span>Device connections</span>
          <button class="btn btn-secondary btn-sm" id="conn-check" type="button">Check again</button>
        </div>
        <div class="card-body">
          <p id="conn-summary" style="font-weight:600">Checking which devices can reach the broker…</p>
          <p class="mqtt-hint" id="conn-help" style="display:none;margin-top:6px">
            A device that isn't connected is usually still set up for the old broker, which didn't need a password.
            Enter the <strong>User</strong> and <strong>Password</strong> shown above on the device — Tasmota: <strong>Configuration → Configure MQTT</strong>; Shelly: <strong>Settings → MQTT</strong> — then press <strong>Check again</strong>.
          </p>
          <div id="conn-list" style="margin-top:12px"></div>
        </div>
      </div>
      <% } %>

      <% if (brokerAvailable && (tasmotaEnabled || shellyEnabled)) { %>
      <!-- Setup guides -->
      <div class="section-header" style="margin-bottom:16px;">
        <h2 class="section-title">Plugin setup guides</h2>
        <p style="color:var(--text-muted); font-size:13px; margin-top:4px;">Follow the steps for each plugin you're using. You only need to do this once per device.</p>
      </div>

      <div class="tab-bar" style="margin-bottom:20px;">
        <% if (tasmotaEnabled) { %><button class="tab-btn active" onclick="showTab('tasmota', this)">Tasmota</button><% } %>
        <% if (shellyEnabled) { %><button class="tab-btn <%= tasmotaEnabled ? '' : 'active' %>" onclick="showTab('shelly', this)">Shelly</button><% } %>
      </div>

      <!-- Tasmota tab -->
      <% if (tasmotaEnabled) { %>
      <div class="tab-pane" id="tab-tasmota">
        <div class="card" style="margin-bottom:16px;">
          <div class="card-header">How to connect a Tasmota device</div>
          <div class="card-body">
            <ol class="setup-steps">
              <li>Open your Tasmota device's web UI in a browser (go to its IP address).</li>
              <li>Go to <strong>Configuration → Configure MQTT</strong>.</li>
              <li>Set <strong>Host</strong> to <code class="inline-code"><%= localIp %></code></li>
              <li>Set <strong>Port</strong> to <code class="inline-code">1883</code></li>
              <li>Set <strong>User</strong> to <code class="inline-code"><%= mqttUser %></code> and <strong>Password</strong> to <code class="inline-code"><%= mqttPass %></code></li>
              <li>Set <strong>Topic</strong> to the value shown for your device below.</li>
              <li>Set <strong>Full Topic</strong> to <code class="inline-code">%prefix%/%topic%/</code></li>
              <li>Click Save — the device will reboot and start publishing to Rowan Hub.</li>
              <li>Add the same value to the <strong>MQTT Topic</strong> field on the Devices page (or leave blank if it matches the device ID).</li>
            </ol>
          </div>
        </div>

        <% if (tasmotaDevices.length === 0) { %>
        <div class="empty-state-sm">No Tasmota devices configured yet. Add one on the <a href="/devices">Devices page</a>.</div>
        <% } else { %>
        <div class="device-grid">
          <% for (const d of tasmotaDevices) { %>
          <div class="card device-mqtt-card">
            <div class="card-body">
              <div class="device-mqtt-name"><%= d.name %> <span class="pill" data-conn="<%= d.id %>" hidden></span></div>
              <div class="device-mqtt-id">Device ID: <code class="inline-code"><%= d.id %></code></div>
              <div class="mqtt-topic-row">
                <div class="mqtt-topic-block">
                  <div class="mqtt-topic-label">Set Topic to</div>
                  <div class="mqtt-topic-value">
                    <code class="inline-code" id="t-topic-<%= d.id %>"><%= d.mqtt_topic || d.id %></code>
                    <button class="btn-icon" onclick="copy('<%= d.mqtt_topic || d.id %>')" title="Copy">
                      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M3 11H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1"/></svg>
                    </button>
                  </div>
                </div>
                <div class="mqtt-topic-block">
                  <div class="mqtt-topic-label">State topic (Rowan Hub listens on)</div>
                  <div class="mqtt-topic-value">
                    <code class="inline-code">stat/<%= d.mqtt_topic || d.id %>/POWER<%= d.channel !== undefined ? d.channel : '' %></code>
                  </div>
                </div>
              </div>
              <% if (!d.mqtt_topic) { %>
              <div class="mqtt-hint">Topic matches device ID — no change needed in Rowan Hub.</div>
              <% } else { %>
              <div class="mqtt-hint">Custom topic set via <code>mqtt_topic</code> field.</div>
              <% } %>
            </div>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
      <% } %>

      <!-- Shelly tab -->
      <% if (shellyEnabled) { %>
      <div class="tab-pane" id="tab-shelly" style="<%= tasmotaEnabled ? 'display:none' : '' %>">
        <div class="card" style="margin-bottom:16px;">
          <div class="card-header">How to connect a Shelly device</div>
          <div class="card-body">
            <p style="color:var(--text-muted); font-size:13px; margin-bottom:16px;">MQTT mode applies to <strong>Gen1 Shelly devices only</strong>. Gen2 devices already use a live WebSocket connection and don't need MQTT.</p>
            <ol class="setup-steps">
              <li>Open your Shelly device's web UI (go to its IP address).</li>
              <li>Go to <strong>Settings → MQTT</strong>.</li>
              <li>Enable MQTT and set <strong>Server</strong> to <code class="inline-code"><%= localIp %>:1883</code></li>
              <li>Set <strong>Username</strong> to <code class="inline-code"><%= mqttUser %></code> and <strong>Password</strong> to <code class="inline-code"><%= mqttPass %></code></li>
              <li>Click Save — the device will reboot.</li>
              <li>Find the <strong>Device ID</strong> in <strong>Settings → Device Info</strong> (e.g. <code class="inline-code">shelly1-AABBCC</code>).</li>
              <li>Add this ID to the <strong>MQTT Device ID</strong> field for the device on the <a href="/devices">Devices page</a>.</li>
            </ol>
          </div>
        </div>

        <% if (shellyDevices.length === 0) { %>
        <div class="empty-state-sm">No Shelly devices configured yet. Add one on the <a href="/devices">Devices page</a>.</div>
        <% } else { %>
        <div class="device-grid">
          <% for (const d of shellyDevices) { %>
          <div class="card device-mqtt-card">
            <div class="card-body">
              <div class="device-mqtt-name"><%= d.name %> <span class="pill" data-conn="<%= d.id %>" hidden></span></div>
              <% if (d.mqtt_id) { %>
              <div class="mqtt-topic-row">
                <div class="mqtt-topic-block">
                  <div class="mqtt-topic-label">MQTT Device ID</div>
                  <div class="mqtt-topic-value"><code class="inline-code"><%= d.mqtt_id %></code></div>
                </div>
                <div class="mqtt-topic-block">
                  <div class="mqtt-topic-label">State topic (Rowan Hub listens on)</div>
                  <div class="mqtt-topic-value"><code class="inline-code">shellies/<%= d.mqtt_id %>/relay/<%= d.channel || 0 %></code></div>
                </div>
              </div>
              <div class="mqtt-hint" style="color:var(--success);">✓ MQTT Device ID configured.</div>
              <% } else { %>
              <div class="mqtt-hint" style="color:var(--warn);">MQTT Device ID not set. Add it on the <a href="/devices">Devices page</a> to enable MQTT mode for this device.</div>
              <% } %>
            </div>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
      <% } %>
      <% } %>

      <% } %>

    </div>
  </main>
</div>
<script src="/js/main.js"></script>
<script>
function showTab(name, btn) {
  document.querySelectorAll('.tab-pane').forEach(p => p.style.display = 'none');
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + name).style.display = '';
  btn.classList.add('active');
}

async function toggleBroker(enable) {
  const btn = document.getElementById('broker-toggle-btn');
  btn.disabled = true;
  btn.textContent = enable ? 'Starting…' : 'Stopping…';
  try {
    const r = await fetch('/api/mqtt/broker', {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled: enable }),
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || 'Failed');
    document.getElementById('broker-dot').className = 'status-dot ' + (enable ? 'online' : 'offline');
    document.getElementById('broker-status-text').textContent = enable ? 'Running' : 'Stopped';
    btn.textContent = enable ? 'Stop broker' : 'Start broker';
    btn.className   = enable ? 'btn btn-sm btn-danger' : 'btn btn-sm btn-primary';
    btn.onclick     = () => toggleBroker(!enable);
    document.getElementById('restart-notice').style.display = '';
  } catch (e) {
    alert('Error: ' + e.message);
    btn.disabled = false;
    btn.textContent = enable ? 'Start broker' : 'Stop broker';
  }
}

// ── Device connections ──
async function checkConnections(nudge) {
  const box = document.getElementById('mqtt-conn');
  if (!box) return;
  const btn = document.getElementById('conn-check');
  btn.disabled = true;
  try {
    if (nudge) { await fetch('/api/mqtt/probe', { method: 'POST' }); await new Promise(r => setTimeout(r, 2500)); }
    const data = await (await fetch('/api/mqtt/devices')).json();
    const list = document.getElementById('conn-list');
    list.textContent = '';
    if (!data.tracking) {
      document.getElementById('conn-summary').textContent = 'Restart Rowan Hub to start checking device connections.';
      return;
    }
    let missing = 0;
    data.devices.forEach(d => {
      const state = d.connected ? 'ok' : (data.settled ? 'missing' : 'checking');
      if (state === 'missing') missing++;
      const label = { ok: 'Connected', missing: 'Not connected', checking: 'Checking…' }[state];
      const cls = { ok: 'pill pill--success', missing: 'pill pill--warn', checking: 'pill' }[state];
      const row = document.createElement('div');
      row.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;border-top:1px solid var(--divider)';
      const name = document.createElement('span'); name.textContent = d.name;
      const pill = document.createElement('span'); pill.className = cls; pill.textContent = label;
      row.append(name, pill); list.appendChild(row);
      const tag = document.querySelector('[data-conn="' + CSS.escape(d.id) + '"]');
      if (tag) { tag.hidden = false; tag.className = cls; tag.textContent = label; }
    });
    const total = data.devices.length;
    document.getElementById('conn-summary').textContent = !data.settled && missing === 0 && data.devices.some(d => !d.connected)
      ? 'Still checking — devices have a minute to answer after Rowan Hub starts.'
      : missing ? missing + ' of ' + total + ' device' + (total === 1 ? '' : 's') + ' not connected'
      : 'All ' + total + ' device' + (total === 1 ? ' is' : 's are') + ' connected';
    document.getElementById('conn-help').style.display = missing ? '' : 'none';
  } catch (e) {
    document.getElementById('conn-summary').textContent = 'Couldn’t check connections: ' + e.message;
  } finally {
    btn.disabled = false;
  }
}
if (document.getElementById('mqtt-conn')) {
  document.getElementById('conn-check').addEventListener('click', () => checkConnections(true));
  checkConnections(true);
}

function copyAddr() { copy('<%= localIp %>:1883'); }

function copy(text) {
  navigator.clipboard.writeText(text).catch(() => {});
}

async function restart() {
  await fetch('/api/system/restart', { method: 'POST' });
  setTimeout(() => { const poll = setInterval(async () => { try { const r = await fetch('/api/system'); if (r.ok) { clearInterval(poll); location.reload(); } } catch {} }, 1500); }, 1000);
}
</script>
<style>
.mqtt-page .card { padding: 0; }
.mqtt-page .card-body { padding: 18px 20px; }
.mqtt-page .card-header { padding: 16px 20px; border-bottom: 1px solid var(--divider); font-weight: 700; font-size: 16px; }
.setup-steps { margin: 0; padding-left: 22px; line-height: 1.9; }
.tab-bar { display: flex; gap: 4px; border-bottom: 1px solid var(--border); }
.tab-btn { min-height: 44px; background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; padding: 0 16px; color: var(--text-muted); font-size: 15px; font-weight: 500; cursor: pointer; }
.tab-btn.active { color: var(--text); font-weight: 600; border-bottom-color: var(--accent); }
.device-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
.device-mqtt-name { font-weight: 700; font-size: 16px; margin-bottom: 4px; }
.device-mqtt-id { color: var(--text-muted); font-size: 13px; margin-bottom: 12px; }
.mqtt-topic-row { display: flex; flex-direction: column; gap: 10px; margin-bottom: 10px; }
.mqtt-topic-block { display: flex; flex-direction: column; gap: 4px; }
.mqtt-topic-label { font-size: 13px; font-weight: 600; color: var(--text-muted); }
.mqtt-topic-value { display: flex; align-items: center; gap: 6px; }
.mqtt-hint { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
.status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex: none; background: var(--dot-off); }
.status-dot.online { background: var(--success); }
.empty-state-sm { color: var(--text-muted); padding: 16px 0; }
.mqtt-page .btn-icon { width: 36px; height: 36px; }
</style>
</body>
</html>
