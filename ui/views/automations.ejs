<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Automations' }) %>
</head>
<body>
<%
  function nameOf(id) { return deviceNames[id] || id; }
  var active = automations.filter(function (a) { return a.enabled; });
  var paused = automations.filter(function (a) { return !a.enabled; });
  var groups = [];
  if (active.length) groups.push({ title: 'Active', items: active });
  if (paused.length) groups.push({ title: 'Paused', items: paused });
%>
<div class="app">
  <%- include('partials/sidebar') %>
  <main class="main">
    <div class="container container--narrow">

      <header class="page-head">
        <div>
          <h1>Automations</h1>
          <p class="page-sub"><%= active.length %> active · <%= paused.length %> paused · sunrise and sunset follow your location</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-primary" id="btn-add-auto"><%- include('partials/icon', { name: 'plus', size: 16, stroke: 2.2 }) %>New automation</button>
        </div>
      </header>

      <% if (automations.length === 0) { %>
      <div class="empty-state">
        <span class="empty-icon"><%- include('partials/icon', { name: 'automations', size: 26 }) %></span>
        <h2>No automations yet</h2>
        <p>Turn devices on or off at a set time, or at sunrise and sunset — for example “At sunset, turn on the driveway lights”.</p>
        <button class="btn btn-primary" id="btn-add-auto-empty">Create an automation</button>
      </div>
      <% } %>

      <% groups.forEach(function (g) { %>
      <section aria-label="<%= g.title %> automations">
        <div class="section-head"><h2><%= g.title %></h2><span class="count"><%= g.items.length %></span></div>
        <% g.items.forEach(function (auto) {
             var t = auto.trigger || {};
             var icon = t.type === 'sunrise' ? 'sunrise' : t.type === 'sunset' ? 'sunset' : 'automations';
             var skipped = (auto.actions || []).filter(function (a) { return disabledIds.indexOf(a.device) !== -1; })
                                               .map(function (a) { return nameOf(a.device); });
             skipped = skipped.filter(function (n, i) { return skipped.indexOf(n) === i; });
             var everyActionSkipped = skipped.length && (auto.actions || []).every(function (a) { return disabledIds.indexOf(a.device) !== -1; });
             var next = nextRuns[auto.id]; %>
        <article class="card auto-card<%= auto.enabled ? '' : ' is-paused' %>" data-auto-id="<%= auto.id %>">
          <span class="row-icon"><%- include('partials/icon', { name: icon, size: 22 }) %></span>
          <div class="row-main">
            <div class="row-title"><%= auto.name %><% if (!auto.enabled) { %><span class="pill">Paused</span><% } %></div>
            <p class="sentence"><strong><%= describe.triggerText(t) %></strong>, <%= describe.actionsText(auto.actions, nameOf) %></p>
            <% if (skipped.length) { %>
            <p class="warn-text"><%- include('partials/icon', { name: 'warn', size: 15, stroke: 2 }) %>
              <%= describe.joinNames(skipped) %> <%= skipped.length === 1 ? 'is' : 'are' %> disabled<%= everyActionSkipped ? ', so this has nothing to control' : ' and will be skipped' %>
            </p>
            <% } %>
          </div>
          <div class="row-meta">
            <% if (auto.enabled && next) { %><strong>Next run</strong><%= describe.whenText(next) %>
            <% } else if (auto.enabled) { %><strong>Next run</strong>Not this week
            <% } else { %><strong>Paused</strong>Won’t run<% } %>
          </div>
          <label class="toggle-switch" title="<%= auto.enabled ? 'Pause' : 'Resume' %>">
            <input type="checkbox" class="auto-toggle" data-id="<%= auto.id %>" aria-label="<%= auto.enabled ? 'Pause' : 'Resume' %> <%= auto.name %>" <%= auto.enabled ? 'checked' : '' %>>
            <span class="toggle-slider"></span>
          </label>
          <div class="row-actions" style="margin-left:0">
            <button class="btn btn-secondary btn-sm btn-edit-auto" data-id="<%= auto.id %>"><%- include('partials/icon', { name: 'edit', size: 16 }) %>Edit</button>
            <button class="btn-icon btn-delete-auto" data-id="<%= auto.id %>" aria-label="Delete <%= auto.name %>" title="Delete"><%- include('partials/icon', { name: 'trash', size: 18 }) %></button>
          </div>
        </article>
        <% }); %>
      </section>
      <% }); %>

    </div>
  </main>
</div>

<div class="modal-overlay" id="auto-modal" role="dialog" aria-modal="true" aria-labelledby="auto-modal-title">
  <div class="modal">
    <div class="modal-header">
      <h2 class="modal-title" id="auto-modal-title">New automation</h2>
      <button class="modal-close" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="auto-id">
      <div class="form-group">
        <label class="form-label" for="auto-name">Name</label>
        <input type="text" class="form-input" id="auto-name" placeholder="e.g. Driveway lights at sunset">
      </div>
      <div class="form-group">
        <label class="form-label" for="auto-type">When</label>
        <select class="form-input" id="auto-type">
          <option value="time">At a set time</option>
          <option value="sunrise">At sunrise</option>
          <option value="sunset">At sunset</option>
        </select>
      </div>
      <div class="form-group" id="group-time">
        <label class="form-label" for="auto-time">Time</label>
        <input type="time" class="form-input" id="auto-time" value="00:00">
      </div>
      <div class="form-group" id="group-offset" style="display:none">
        <label class="form-label" for="auto-offset">Offset in minutes</label>
        <input type="number" class="form-input" id="auto-offset" value="0" min="-120" max="120">
        <span class="form-hint">Negative = before, e.g. -30 runs half an hour before sunset.</span>
      </div>
      <div class="form-group">
        <span class="form-label">On these days</span>
        <div class="day-picker">
          <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(function (d, i) { %>
          <label class="day-btn"><input type="checkbox" class="day-check" value="<%= i %>"><span><%= d %></span></label>
          <% }); %>
        </div>
        <span class="form-hint">Leave them all unticked to run every day.</span>
      </div>
      <div class="form-group">
        <span class="form-label">What should happen?</span>
        <div id="actions-list"></div>
        <button class="btn btn-dashed btn-sm" id="btn-add-action" type="button">+ Add a device</button>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary modal-close">Cancel</button>
      <button class="btn btn-primary" id="btn-save-auto">Save automation</button>
    </div>
  </div>
</div>

<script>
  window.DEVICES = <%- JSON.stringify(devices).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/main.js"></script>
<script src="/js/automations.js"></script>
</body>
</html>
