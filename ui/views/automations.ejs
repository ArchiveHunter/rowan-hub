<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%- include('partials/head') %>
</head>
<body>
<div class="app-layout">
  <%- include('partials/sidebar', { page: 'automations' }) %>
  <main class="main-content">
    <div class="page-container">

      <div class="page-header">
        <h1>Automations</h1>
        <div class="header-actions">
          <button class="btn btn-primary" id="btn-add-auto">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="8" y1="2" x2="8" y2="14"/><line x1="2" y1="8" x2="14" y2="8"/></svg>
            Add Automation
          </button>
        </div>
      </div>

      <% if (automations.length === 0) { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" opacity="0.3">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <p>No automations yet. Add one to schedule your devices.</p>
          <button class="btn btn-primary" id="btn-add-auto-empty">Add Automation</button>
        </div>
      <% } else { %>
      <div class="card">
        <table class="device-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Trigger</th>
              <th>Actions</th>
              <th>Enabled</th>
              <th style="text-align:right">Edit</th>
            </tr>
          </thead>
          <tbody id="auto-list">
            <% automations.forEach(function(auto) { %>
            <tr data-auto-id="<%= auto.id %>">
              <td><strong><%= auto.name %></strong></td>
              <td class="text-muted" style="font-size:12px">
                <% if (auto.trigger.type === 'time') { %>
                  At <strong><%= auto.trigger.time %></strong>
                <% } else { %>
                  At <strong><%= auto.trigger.type %></strong>
                  <% if (auto.trigger.offset && auto.trigger.offset !== 0) { %>
                    (<%= auto.trigger.offset > 0 ? '+' : '' %><%= auto.trigger.offset %>min)
                  <% } %>
                <% } %>
                <% if (auto.trigger.days && auto.trigger.days.length > 0) { %>
                  <br><span><%- ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].filter((_,i) => auto.trigger.days.includes(i)).join(', ') %></span>
                <% } else { %>
                  <br><span>Every day</span>
                <% } %>
              </td>
              <td class="text-muted" style="font-size:12px">
                <% auto.actions.forEach(function(a) { %>
                  <div><%= a.device %> → <%= a.capability %> <strong><%= String(a.value) %></strong></div>
                <% }); %>
              </td>
              <td>
                <label class="toggle-switch">
                  <input type="checkbox" class="auto-toggle" data-id="<%= auto.id %>" <%= auto.enabled ? 'checked' : '' %>>
                  <span class="toggle-track"></span>
                </label>
              </td>
              <td style="text-align:right">
                <button class="btn-icon btn-edit-auto" data-id="<%= auto.id %>" title="Edit">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11.5 2.5a1.414 1.414 0 0 1 2 2L5 13l-3 1 1-3 8.5-8.5z"/>
                  </svg>
                </button>
                <button class="btn-icon btn-delete-auto" data-id="<%= auto.id %>" title="Delete">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="2 4 14 4"/><path d="M5 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1"/><path d="M6 7v5M10 7v5"/><rect x="3" y="4" width="10" height="10" rx="1"/>
                  </svg>
                </button>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>

    </div>
  </main>
</div>

<!-- Add / Edit modal -->
<div class="modal-overlay" id="auto-modal">
  <div class="modal" style="max-width:520px">
    <div class="modal-header">
      <span class="modal-title" id="auto-modal-title">Add Automation</span>
      <button class="modal-close">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="auto-id">

      <div class="form-group">
        <label class="form-label">Name</label>
        <input type="text" class="form-input" id="auto-name" placeholder="e.g. Driveway Lights On at Sunset">
      </div>

      <div class="form-group">
        <label class="form-label">Trigger type</label>
        <select class="form-input" id="auto-type">
          <option value="time">Specific time</option>
          <option value="sunrise">Sunrise</option>
          <option value="sunset">Sunset</option>
        </select>
      </div>

      <div class="form-group" id="group-time">
        <label class="form-label">Time</label>
        <input type="time" class="form-input" id="auto-time" value="00:00">
      </div>

      <div class="form-group" id="group-offset" style="display:none">
        <label class="form-label">Offset (minutes, negative = before)</label>
        <input type="number" class="form-input" id="auto-offset" value="0" min="-120" max="120">
      </div>

      <div class="form-group">
        <label class="form-label">Days (leave all unchecked = every day)</label>
        <div class="day-picker">
          <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(function(d, i) { %>
          <label class="day-btn"><input type="checkbox" class="day-check" value="<%= i %>"><span><%= d %></span></label>
          <% }); %>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Actions</label>
        <div id="actions-list"></div>
        <button class="btn btn-secondary btn-sm" id="btn-add-action" style="margin-top:8px">+ Add action</button>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary modal-close">Cancel</button>
      <button class="btn btn-primary" id="btn-save-auto">Save</button>
    </div>
  </div>
</div>

<script>
  window.DEVICES = <%- JSON.stringify(devices) %>;
</script>
<script src="/js/automations.js"></script>
</body>
</html>
