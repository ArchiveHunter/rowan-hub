<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Logs' }) %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar') %>
  <main class="main">
    <div class="container">
      <%- include('partials/settings-tabs') %>

      <div class="page-head" style="align-items:center">
        <p class="page-sub" style="margin:0">Live activity from Rowan Hub and your devices.</p>
        <div class="page-actions">
          <label class="sr-only" for="log-filter">Show</label>
          <select id="log-filter" style="width:auto;min-width:150px">
            <option value="all">Everything</option>
            <option value="info">Info</option>
            <option value="warn">Warnings</option>
            <option value="error">Errors</option>
          </select>
          <button class="btn btn-secondary" id="btn-pause">Pause</button>
          <button class="btn btn-secondary" id="btn-clear">Clear</button>
        </div>
      </div>

      <div id="log-console" class="log-console" role="log" aria-live="polite" aria-label="Log output">
        <div class="log-empty">Connecting to the log stream…</div>
      </div>

    </div>
  </main>
</div>
<script src="/js/main.js"></script>
<script src="/js/logs.js"></script>
</body>
</html>
